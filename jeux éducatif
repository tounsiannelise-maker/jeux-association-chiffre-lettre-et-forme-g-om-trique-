// =====================================================================
// MAIN TABS
// =====================================================================
document.querySelectorAll('.main-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.main-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.main-section').forEach(s => s.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('section-' + btn.dataset.main).classList.add('active');
  });
});

// =====================================================================
// SPEECH
// =====================================================================
function speak(text) {
  if (!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'fr-FR'; u.rate = 0.85; u.pitch = 1.2;
  window.speechSynthesis.speak(u);
}

// =====================================================================
// TOAST
// =====================================================================
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}

// =====================================================================
// ASSOCIATIONS GAME
// =====================================================================
let currentCategory = null, questions = [], currentIdx = 0,
    score = 0, totalCorrect = 0, answered = false;

function initAssoc() {
  const grid = document.getElementById('cat-grid');
  grid.innerHTML = '';
  CATEGORIES.forEach(cat => {
    const btn = document.createElement('button');
    btn.className = 'cat-btn';
    btn.innerHTML = `<span class="cat-emoji">${cat.emoji}</span><span class="cat-label">${cat.label}</span>`;
    btn.onclick = () => startCategory(cat);
    grid.appendChild(btn);
  });
  showAssocScreen('category-screen');
}

function showAssocScreen(id) {
  ['category-screen','game-screen','victory-screen'].forEach(sid => {
    const el = document.getElementById(sid);
    el.style.display = sid === id ? 'flex' : 'none';
  });
}

function startCategory(cat) {
  currentCategory = cat;
  score = 0; totalCorrect = 0; currentIdx = 0; answered = false;
  const shuffled = [...cat.pairs].sort(() => Math.random()-0.5).slice(0,6);
  questions = shuffled;
  document.getElementById('score').textContent = '0';
  document.getElementById('progress-fill').style.width = '0%';
  document.getElementById('question-label').textContent = cat.prompt;
  showAssocScreen('game-screen');
  showQuestion();
}

function showQuestion() {
  if (currentIdx >= questions.length) { showVictory(); return; }
  answered = false;
  const q = questions[currentIdx];
  document.getElementById('progress-fill').style.width = (currentIdx/questions.length*100)+'%';
  document.getElementById('question-emoji').textContent = q.question.e;
  document.getElementById('question-name').textContent = q.question.name;

  const distractors = [...currentCategory.distractors].sort(()=>Math.random()-0.5).slice(0,3)
    .map(e => ({e, name:''}));
  let allAnswers = [{...q.answer, isCorrect:true}, ...distractors.map(d=>({...d,isCorrect:false}))]
    .sort(()=>Math.random()-0.5);

  const grid = document.getElementById('answers-grid');
  grid.innerHTML = ''; grid.className = 'answers-grid cols-2';
  allAnswers.forEach((ans, i) => {
    const card = document.createElement('div');
    card.className = 'answer-card';
    card.style.animationDelay = (i*0.07)+'s';
    card.innerHTML = `<span class="answer-emoji">${ans.e}</span>${ans.name?`<span class="answer-name">${ans.name}</span>`:''}`;
    card.onclick = () => handleAnswer(card, ans.isCorrect);
    grid.appendChild(card);
  });
}

function handleAnswer(card, isCorrect) {
  if (answered) return;
  answered = true;
  if (isCorrect) {
    card.classList.add('correct');
    score += 10; totalCorrect++;
    document.getElementById('score').textContent = score;
    showFeedback(true);
    spawnStars(card);
  } else {
    card.classList.add('wrong');
    document.querySelectorAll('.answer-card').forEach(c => { if(!c.classList.contains('wrong')) c.classList.add('correct'); });
    showFeedback(false);
  }
  setTimeout(() => { hideFeedback(); currentIdx++; showQuestion(); }, 1200);
}

const correctMessages = ['Bravo ! 🎉','Super ! ⭐','Génial ! 🌟','Parfait ! 💛','Ouiii ! 🎊'];
const wrongMessages   = ['Essaie encore !','Presque !','Continue !'];

function showFeedback(isCorrect) {
  const fb = document.getElementById('feedback');
  document.getElementById('feedback-emoji').textContent = isCorrect ? ['🌟','⭐','✨','🎉','🏆'][Math.floor(Math.random()*5)] : '😊';
  document.getElementById('feedback-text').textContent  = isCorrect
    ? correctMessages[Math.floor(Math.random()*correctMessages.length)]
    : wrongMessages[Math.floor(Math.random()*wrongMessages.length)];
  fb.className = 'show '+(isCorrect?'correct-fb':'wrong-fb');
  speak(isCorrect ? 'Bravo !' : 'Essaie encore');
}
function hideFeedback() { document.getElementById('feedback').className = ''; }

function showVictory() {
  const pct = totalCorrect/questions.length;
  const stars = pct>=0.9?'⭐⭐⭐':pct>=0.6?'⭐⭐':'⭐';
  const title = pct>=0.9?'Bravo champion !':pct>=0.6?'Très bien !':'Continuons !';
  document.getElementById('victory-title').textContent = title;
  document.getElementById('victory-stars').textContent = stars;
  document.getElementById('victory-score').textContent = `${totalCorrect} / ${questions.length} bonnes réponses — ${score} points !`;
  showAssocScreen('victory-screen');
  launchConfetti();
  speak(title);
}

function goHome() { hideFeedback(); initAssoc(); }
function replayCategory() { if(currentCategory) startCategory(currentCategory); }

// =====================================================================
// LETTRES
// =====================================================================
function buildAlphabet() {
  const grid = document.getElementById('alphabet-grid');
  ALPHABET.forEach(({l,sound,ex,mot}) => {
    const card = document.createElement('div');
    card.className = 'letter-card';
    card.innerHTML = `
      <div class="letter-big">${l}</div>
      <div class="letter-sound">Son : « ${sound} »</div>
      <div class="letter-example">${ex}</div>
      <div class="letter-word">${mot}</div>
      <button class="sound-btn" onclick="event.stopPropagation();playLetter('${l}','${sound}','${mot}',this)">🔊 Écouter</button>
    `;
    card.addEventListener('click', () => playLetter(l, sound, mot, card.querySelector('.sound-btn')));
    grid.appendChild(card);
  });
}

function playLetter(l, sound, mot, btn) {
  speak(`La lettre ${l}. Son son est ${sound}. Exemple : ${mot}`);
  const card = btn.closest('.letter-card');
  card.classList.add('playing');
  setTimeout(() => card.classList.remove('playing'), 1400);
}

// =====================================================================
// CHIFFRES
// =====================================================================
function buildNumbers() {
  const grid = document.getElementById('numbers-grid');
  NUMBERS.forEach(({n,word,emoji}) => {
    const card = document.createElement('div');
    card.className = 'number-card';
    card.innerHTML = `
      <div class="number-big">${n}</div>
      <div class="number-emoji">${emoji}</div>
      <div class="number-word">${word}</div>
    `;
    card.addEventListener('click', () => {
      speak(`${n} : ${word}`);
      card.classList.add('playing');
      setTimeout(() => card.classList.remove('playing'), 1000);
    });
    grid.appendChild(card);
  });
}

// =====================================================================
// FORMES
// =====================================================================
function buildShapes() {
  const grid = document.getElementById('shapes-grid');
  SHAPES.forEach(({name,sides,color,obj,svg}) => {
    const card = document.createElement('div');
    card.className = 'shape-card';
    card.style.borderColor = color+'55';
    card.innerHTML = `
      <svg class="shape-svg" viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg">${svg}</svg>
      <div class="shape-name" style="color:${color}">${name}</div>
      <div class="shape-info">${sides}</div>
      <div class="shape-info" style="margin-top:3px">${obj}</div>
    `;
    card.addEventListener('click', () => {
      speak(`${name}. ${sides}. Exemple : ${obj.replace(/[^\w\sÀ-ÿ]/g,'')}`);
      card.classList.add('playing');
      setTimeout(() => card.classList.remove('playing'), 1000);
    });
    grid.appendChild(card);
  });
}

// =====================================================================
// FX
// =====================================================================
function spawnStars(card) {
  const rect = card.getBoundingClientRect();
  const cx = rect.left + rect.width/2, cy = rect.top + rect.height/2;
  ['⭐','✨','🌟'].forEach((s,i) => {
    const el = document.createElement('div');
    el.className = 'star-rain'; el.textContent = s;
    el.style.left = (cx+(i-1)*30)+'px'; el.style.top = cy+'px';
    el.style.animationDelay = (i*0.1)+'s';
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 1500);
  });
}

function launchConfetti() {
  const colors = ['#FF6B6B','#FFD93D','#6BCB77','#6DD5FA','#C77DFF','#FF9A3C','#FF6B9D'];
  for(let i=0;i<40;i++) {
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'confetti-piece';
      el.style.left = Math.random()*100+'vw';
      el.style.top = '-20px';
      el.style.background = colors[Math.floor(Math.random()*colors.length)];
      el.style.transform = `rotate(${Math.random()*360}deg)`;
      el.style.animationDuration = (1.2+Math.random()*1.2)+'s';
      el.style.animationDelay = (Math.random()*0.8)+'s';
      el.style.borderRadius = Math.random()>0.5?'50%':'3px';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 3000);
    }, i*40);
  }
}

// =====================================================================
// INIT
// =====================================================================
initAssoc();
buildAlphabet();
buildNumbers();
buildShapes();
</script>
